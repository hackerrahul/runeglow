{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// The core is read from its source, so a check needs no build of it.
		// Setting paths replaces the generated ones, so $lib is said again.
		"paths": {
			"runeglow/*": ["../runeglow/src/*/index.ts"],
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
