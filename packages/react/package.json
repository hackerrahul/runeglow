{
	"name": "@runeglow/react",
	"version": "0.4.0",
	"description": "Runeglow for React: animated bot avatars and robot heads for AI agents, as React components on the framework-free runeglow core.",
	"keywords": [
		"react",
		"animation",
		"effects",
		"canvas",
		"avatar",
		"robot",
		"ai",
		"agent",
		"ui"
	],
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./border-beam": {
			"types": "./dist/border-beam/index.d.ts",
			"default": "./dist/border-beam/index.js"
		},
		"./thinking-orbs": {
			"types": "./dist/thinking-orbs/index.d.ts",
			"default": "./dist/thinking-orbs/index.js"
		},
		"./bot-avatars": {
			"types": "./dist/bot-avatars/index.d.ts",
			"default": "./dist/bot-avatars/index.js"
		},
		"./liquid-gooey": {
			"types": "./dist/liquid-gooey/index.d.ts",
			"default": "./dist/liquid-gooey/index.js"
		},
		"./voice-glow": {
			"types": "./dist/voice-glow/index.d.ts",
			"default": "./dist/voice-glow/index.js"
		},
		"./voice-ring": {
			"types": "./dist/voice-ring/index.d.ts",
			"default": "./dist/voice-ring/index.js"
		},
		"./metal-fx": {
			"types": "./dist/metal-fx/index.d.ts",
			"default": "./dist/metal-fx/index.js"
		},
		"./img-fx": {
			"types": "./dist/img-fx/index.d.ts",
			"default": "./dist/img-fx/index.js"
		},
		"./distortion-waves": {
			"types": "./dist/distortion-waves/index.d.ts",
			"default": "./dist/distortion-waves/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"runeglow": "workspace:^"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"three": ">=0.149.0"
	},
	"peerDependenciesMeta": {
		"three": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/react": "^19.2.0",
		"react": "^19.2.0",
		"typescript": "^6.0.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT",
	"homepage": "https://runeglow.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hackerrahul/runeglow.git",
		"directory": "packages/react"
	},
	"bugs": "https://github.com/hackerrahul/runeglow/issues",
	"author": "Rahul Gangotri"
}
