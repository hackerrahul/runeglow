{
	"name": "Runeglow",
	"short_name": "Runeglow",
	"description": "UI effects for Svelte",
	"start_url": "/",
	"display": "browser",
	"background_color": "#121212",
	"theme_color": "#121212",
	"icons": [
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png"
		},
		{
			"src": "/favicon.svg",
			"sizes": "any",
			"type": "image/svg+xml"
		}
	]
}
