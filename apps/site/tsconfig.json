{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@runeglow/svelte/*": [
				"../../packages/svelte/src/lib/*/index.ts"
			],
			"runeglow/*": [
				"../../packages/runeglow/src/*/index.ts"
			]
		},
		"types": [
			"$app/types",
			"node"
		]
	},
	"include": [
		"src",
		"worker",
		"vite.config.ts"
	]
}
